# Copia este archivo como .env.local para probar con `vercel dev`.
# En producción estas variables se configuran en Vercel > Settings > Environment Variables.

# --- Tablero SCD CDMX (board=scd) ---
APPS_SCRIPT_URL=https://script.google.com/macros/s/XXXXXXXX/exec
API_SECRET=pega-aqui-la-clave-de-generarSecreto
TEAM_CODE=un-codigo-para-el-equipo

# --- Tablero SBG IPN (board=sbg) · su propia hoja de Google Sheets ---
# Son otra implementación de Apps Script (otra hoja) con su propia clave y código.
APPS_SCRIPT_URL_SBG=https://script.google.com/macros/s/YYYYYYYY/exec
API_SECRET_SBG=pega-aqui-la-clave-de-generarSecreto-del-SBG
TEAM_CODE_SBG=un-codigo-para-el-equipo-del-sbg
